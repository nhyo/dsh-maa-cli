{
  "name": "dsh-maa-cli",
  "version": "0.9.1",
  "description": "A DeepSeek Harness tool bundle for Arknights: prepares and executes maa-cli plans and bootstraps its own MAA runtime.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "local-command.js",
    "confirmation.js",
    "planner.js",
    "runner.js",
    "doctor.js",
    "emulator.js",
    "paths.js",
    "preflight.js",
    "state.js",
    "runtime.js",
    "operator-box.js",
    "README.md",
    "scripts/install-runtime.mjs",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test runner.test.mjs doctor.test.mjs paths.test.mjs preflight.test.mjs state.test.mjs emulator.test.mjs runtime.test.mjs operator-box.test.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.3": "compatible"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "maa",
    "maa-cli",
    "arknights",
    "deepseek-harness"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nhyo/dsh-maa-cli.git"
  },
  "homepage": "https://github.com/nhyo/dsh-maa-cli#readme",
  "bugs": {
    "url": "https://github.com/nhyo/dsh-maa-cli/issues"
  },
  "license": "MIT"
}
