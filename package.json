{
  "name": "dsh-maa-cli",
  "version": "1.0.8",
  "description": "A DeepSeek Harness tool bundle for Arknights: prepares and executes maa-cli plans and bootstraps its own MAA runtime.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client/index.js",
    "./cordis.patch.yml": "./config/cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "config",
    "README.md",
    "CHANGELOG.md",
    "scripts/install-runtime.mjs"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./config/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.3": "compatible"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "maa",
    "maa-cli",
    "arknights",
    "deepseek-harness"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nhyo/dsh-maa-cli.git"
  },
  "homepage": "https://github.com/nhyo/dsh-maa-cli#readme",
  "bugs": {
    "url": "https://github.com/nhyo/dsh-maa-cli/issues"
  },
  "license": "MIT"
}
